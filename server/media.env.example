# 服务端环境配置示例。复制到 .env.media.local，填入实际密钥；不可使用 VITE_ 前缀。
# 第一项为部署默认服务器。apiUrl 供管理服务访问，playbackUrl 必须能被用户浏览器访问。
MEDIA_SERVERS_JSON='[{"id":"zlm-local","name":"局域网 ZLMediaKit","apiUrl":"http://192.168.10.148:18080","playbackUrl":"http://192.168.10.148:18080","secret":"REPLACE_WITH_SERVER_SECRET","allowedHosts":["stream.strba.sk","192.168.10.*"]}]'

# 正式进程必须配置业务令牌验证接口，响应契约见交接文档。
MEDIA_AUTH_CHECK_URL=http://192.168.10.110:48080/admin-api/system/auth/get-permission-info
# 同机反向代理默认仅监听环回地址。容器部署按网络边界调整监听地址。
MEDIA_HOST=127.0.0.1
MEDIA_PORT=5181
