{
  "name": "web-unity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "media:serve": "node --experimental-strip-types server/mediaGatewayServer.ts",
    "unity-web:serve": "node --experimental-strip-types server/unityWebDevGateway.ts",
    "media:test": "node --experimental-strip-types --test server/__tests__/*.test.ts",
    "test:browser:2d": "node scripts/twoDFrontendBrowserSmoke.mjs",
    "audit:frontend": "node scripts/auditFrontendBoundary.mjs"
  },
  "dependencies": {
    "@vueuse/core": "13.9.0",
    "pinia": "3.0.3",
    "vue": "3.5.38",
    "vue-router": "4.6.4",
    "@element-plus/icons-vue": "2.3.2",
    "@tailwindcss/vite": "4.3.1",
    "animate.css": "4.1.1",
    "echarts": "6.1.0",
    "element-plus": "2.14.2",
    "hls.js": "1.7.2",
    "jessibuca": "4.0.0",
    "lodash-es": "4.18.1",
    "mitt": "3.0.1",
    "monaco-editor": "0.54.0",
    "monaco-editor-vue3": "1.0.5",
    "mpegts.js": "1.8.2",
    "sass": "1.101.0",
    "splitpanes": "4.1.2",
    "tailwindcss": "4.3.1",
    "umi-request": "1.4.0",
    "vuedraggable": "4.1.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "22.0.6",
    "@types/node": "22.20.0",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/tsconfig": "0.7.0",
    "typescript": "5.8.3",
    "vite": "7.3.5",
    "vitest": "4.1.9",
    "vue-tsc": "3.3.5",
    "@iconify-json/line-md": "1.2.16",
    "@iconify-json/uim": "1.2.3",
    "@iconify-json/wi": "1.2.1",
    "@types/lodash-es": "4.17.12",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "unplugin-auto-import": "20.1.0",
    "unplugin-icons": "22.3.0",
    "unplugin-vue-components": "29.0.0",
    "@playwright/test": "1.61.0"
  }
}
