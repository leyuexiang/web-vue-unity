# 开发配置示例：复制为 .env.development.local，再填写当前环境的业务地址。
# 正式构建使用 .env.production.local，两个文件均被版本控制忽略；此文件不含真实凭据。
VITE_BASE_URL=/threeWeb/

# 场景列表“进入”所用的双端 Unity 部署地址。缺失配置时对应选项不可点击。
VITE_UNITY_CLOUD_SIGNAL_URL=
VITE_UNITY_CLOUD_APP_ID=
VITE_UNITY_CLOUD_SCENE_KEY=
# Unity Editor 固定 ClientID 联调时填写；正式 Launcher 自动分配时留空。
VITE_UNITY_CLOUD_CLIENT_ID=
# 返回 Unity Web 构建 URL、固定美术发布描述和业务启动信息的可信 JSON 地址。
VITE_UNITY_WEB_BOOTSTRAP_URL=

# 场景、资源、独立登录鉴权共用根地址；当前复用参考项目业务服务器。
# 自建后端完成同一契约后只替换此地址；不填写 /api 或平台路径。
VITE_DIM3D_SERVER_URL=http://192.168.10.200:30080
# 对象存储资源根地址，应用会自行追加 /amm/。
VITE_DIM3D_AMM_SERVER_URL=http://192.168.10.120:9000

# 独立登录模式；内嵌页面时改为 true，并配置允许的父页面来源。
VITE_EMBED_MODE=false
# 两端分别使用参考平台的公开应用编号；仅标识应用，不是密码或用户身份。
VITE_AUTH_OPERATION_CLIENT_ID=e5cd7e4891bf95d1d19206ce24a7b32e
VITE_AUTH_TENANT_CLIENT_ID=e5cd75a891bf95d1d19206ce24a7b33c
# 旧 VITE_AUTH_CLIENT_ID 只兼容运营端；租户端必须显式配置，禁止回退到运营应用。
# 参考项目尚未证实续期接口，默认关闭；自建后端实现后才改为 true。
VITE_AUTH_REFRESH_ENABLED=false
VITE_OPERATION_ORIGIN=http://192.168.10.200:30083
VITE_OPERATION_ORIGINS=http://192.168.10.200:30080,http://192.168.10.200:30081,http://192.168.10.200:30083,http://192.168.10.200:30084
VITE_ENABLE_SCENE_LOCK=true

# 数据中间件开发代理；嵌入模式的外部数据接口白名单使用逗号分隔完整来源。
VITE_DATA_MIDDLEWARE_PREFIX=/data-center
VITE_DATA_MIDDLEWARE_URL=http://192.168.10.110:8500
VITE_EMBED_DATA_API_ALLOWED_ORIGINS=
VITE_ENABLE_DEBUG_LOG=false

# 公开发布预览沿用来源的游客账号流程。需要时由环境管理人员提供最小权限账号。
# 这些变量会进入浏览器构建，不可填写管理员凭据；未配置时不代表已验证公开游客预览。
VITE_PUBLIC_PREVIEW_GUEST_PHONENUMBER=
VITE_PUBLIC_PREVIEW_GUEST_PASSWORD=
VITE_PUBLIC_PREVIEW_GUEST_CLIENT_ID=

# Unity 渲染配置为空时保留现有编辑模式，两个 Unity 入口显示未配置。
