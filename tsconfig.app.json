{
  "extends": ["@vue/tsconfig/tsconfig.dom.json", "./tsconfig.base.json"],
  "include": ["env.d.ts", "vue.d.ts", "src/main.ts", "src/packages/**/*.vue", "src/packages/**/*.ts", "src/**/*.d.ts", "src/unity-runtime/**/*.ts", "src/scene-core/**/*.ts", "src/components/unity/UnityViewport.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "skipLibCheck": true,
    // 仅做类型校验，避免 vue-tsc --build 在 src 下误生成 js 产物。
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
